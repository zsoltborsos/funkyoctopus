# Settings for the sidecar, as KEY=VALUE lines.
#
# The sidecar reads an optional settings file at startup:
#   <home>/.funkyoctopus/config.env, or the file named by FUNKYOCTOPUS_CONFIG.
# Copy this file there and edit it. The format is the same as this file's: one
# KEY=VALUE per line, `#` comments, optional quotes. A variable already set in
# the real environment always wins over the file. A missing file is fine; a file
# that exists but cannot be read stops the sidecar. FUNKYOCTOPUS_CONFIG only
# works from the real environment, since the file is found with it.
#
# The `fo` command-line client reads FO_URL and SIDECAR_PORT from the real
# environment only, never from this file.

# Browser → sidecar WebSocket URL; Vite reads this VITE_* value (from a .env in
# the repository root, not from the settings file).
VITE_SIDECAR_URL=ws://127.0.0.1:14788/ws

# Sidecar loopback listener.
SIDECAR_HOST=127.0.0.1
SIDECAR_PORT=14788

# Which engine answers the main chat tab: pi (default) or claude-code.
# FUNKYOCTOPUS_CHAT_ENGINE=pi

# Provider and model pi drives. Optional: unset, pi's own defaultProvider and
# defaultModel settings (pi's settings.json) decide, so a pi you already use
# needs nothing here. Set one or both to override; with neither set and no pi
# default, the sidecar says so and pi chats do not start. Both must exist in
# ~/.pi/agent/models-store.json.
# FUNKYOCTOPUS_PROVIDER=
# FUNKYOCTOPUS_MODEL=

# Paths are used literally (no `~` expansion), so give absolute paths. All are
# optional; unset, the sidecar uses the home-directory defaults shown.

# Initial workspace root until the browser selects a project.
# Default: <home>/Work
# FUNKYOCTOPUS_WORKSPACE_ROOT=/home/you/Work

# Folders the selector's folder list scans one level deep, comma-separated.
# Default: <home>/projects
# FUNKYOCTOPUS_PROJECT_ROOTS=/home/you/projects,/home/you/work

# Vault rules file; created with the default ~/.ssh block rule if absent.
# Default: <home>/.funkyoctopus/vault.json
# FUNKYOCTOPUS_VAULT_PATH=/home/you/.funkyoctopus/vault.json

# Helmraiser CLI binary the sidecar runs for status; default is 'helmraiser' on PATH.
# HELMRAISER_BIN=helmraiser
# Default: <home>/.helmraiser
# HELMRAISER_DATA_DIR=/home/you/.helmraiser

# Claude Code CLI binary; default is 'claude' on PATH.
# CLAUDE_BIN=claude
# How long a Claude Code chat sits idle before its process closes, in milliseconds (default 15 minutes).
# FUNKYOCTOPUS_CLAUDE_IDLE_MS=900000

# Most chat tabs at once, the main one included (default 8), and most Claude
# Code processes running at once across them (default 4).
# FUNKYOCTOPUS_MAX_CHATS=8
# FUNKYOCTOPUS_MAX_CLAUDE_RUNNING=4

# Desktop notifications (notify-send); on only with =1.
# FUNKYOCTOPUS_DESKTOP_NOTIFY=0

# Serve the built UI from the sidecar: 1 for the repository's dist/, or a dist
# directory (absolute, or relative to the working directory). Unset: no UI served.
# FUNKYOCTOPUS_SERVE_UI=1

# Browser-Origin allowlist for the sidecar WebSocket: comma-separated exact
# origins (no wildcards), whitespace-trimmed. Defaults to the pinned Vite dev
# origins http://localhost:14174 and http://127.0.0.1:14174. Vite dev is pinned
# to port 14174 with strictPort, so a busy port fails loudly instead of moving
# the browser to a rejected Origin. `vite preview` (default 4173) or any other
# browser port must set this override to match. An empty value keeps the
# defaults; it never opens access.
# FUNKYOCTOPUS_WS_ORIGINS=http://localhost:14174,http://127.0.0.1:14174

# Automatic `pi update --all` runs after startup and every 24h while the
# sidecar stays alive. Disable with =1; override the interval in milliseconds.
FUNKYOCTOPUS_UPKEEP_DISABLED=0
FUNKYOCTOPUS_UPKEEP_INTERVAL_MS=86400000
