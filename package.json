{
  "name": "funkyoctopus",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "author": "Zsolt Borsos <60493795+zsoltborsos@users.noreply.github.com>",
  "type": "module",
  "description": "Your agents and tools, all within a tentacle's reach. A local, single-user cockpit for coding agents.",
  "scripts": {
    "dev": "VITE_SIDECAR_URL=ws://127.0.0.1:14788/ws vite",
    "dev:server": "SIDECAR_PORT=14788 tsx watch server/src/entrypoint.ts",
    "dev:all": "concurrently -n web,api -c green,cyan \"npm run dev\" \"npm run dev:server\"",
    "server:start": "tsx server/src/entrypoint.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:runtime": "vitest run --config vitest.runtime.config.ts",
    "test:watch": "vitest",
    "promote:pi": "tsx scripts/promote-pi.ts",
    "promote:claude-sdk": "tsx scripts/promote-claude-sdk.ts",
    "service:install": "tsx scripts/service.ts install",
    "deploy": "tsx scripts/service.ts deploy",
    "service:uninstall": "tsx scripts/service.ts uninstall",
    "upkeep:embedded": "tsx tools/pi-upkeep/upkeep-cli.ts",
    "type-check": "tsc -b --noEmit",
    "lint": "eslint . --ignore-pattern tools",
    "lint:fix": "eslint . --fix --ignore-pattern tools",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "verify": "npm run type-check && npm run lint && npm run test",
    "type-check:tools": "tsc -p tools/pi-upkeep/tsconfig.json --noEmit",
    "lint:tools": "eslint tools",
    "test:tools": "vitest run --config tools/pi-upkeep/vitest.config.ts",
    "verify:tools": "npm run type-check:tools && npm run lint:tools && npm run test:tools",
    "prepare": "husky"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.331",
    "@earendil-works/pi-coding-agent": "1.6.0",
    "@fastify/static": "^10.1.11",
    "@fastify/websocket": "^11.3.0",
    "clsx": "^2.1.1",
    "fastify": "^5.10.0",
    "pino-pretty": "^13.1.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "10.1.0",
    "rehype-highlight": "7.0.2",
    "remark-gfm": "4.0.1",
    "tsx": "^4.23.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^26.6.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jsdom": "^31.0.1",
    "prettier": "^3.4.2",
    "puppeteer-core": "^25.17.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "ws": "^8.21.3"
  },
  "engines": {
    "node": ">=26"
  },
  "overrides": {
    "@anthropic-ai/claude-agent-sdk-linux-x64": "file:./stubs/no-claude-binary"
  }
}
